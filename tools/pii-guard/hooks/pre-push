#!/bin/sh
# Scan every commit that is about to be pushed (messages, identity, dates, diffs).
# Only commits no remote ref has yet: commits already public (for example main merged into a branch) are skipped.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  python3 -I "$root/tools/pii-guard/pii_guard.py" --range "$local_sha --not --remotes" || status=1
done
exit $status
