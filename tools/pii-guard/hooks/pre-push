#!/bin/sh
# Scan every commit that is about to be pushed (messages, identity, dates, diffs).
# Commits the push URL already has right now (its live branch heads, read with ls-remote) are skipped.
# If the target cannot be read, nothing is skipped beyond the ref being updated.
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
heads="$(git ls-remote "$2" 'refs/heads/*' 2>/dev/null | cut -f1)" || heads=""
excl=""
for s in $heads; do
  git cat-file -e "$s^{commit}" 2>/dev/null && excl="$excl ^$s"
done
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ -n "$excl" ]; then range="$local_sha$excl"
  elif [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then range="$remote_sha..$local_sha"
  else range="$local_sha"; fi
  python3 -I "$root/tools/pii-guard/pii_guard.py" --range "$range" || status=1
done
exit $status
