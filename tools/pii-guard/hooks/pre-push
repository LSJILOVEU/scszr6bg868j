#!/bin/sh
# Scan every commit that is about to be pushed (messages, identity, dates, diffs).
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha --not --remotes"; else range="$remote_sha..$local_sha"; fi
  python3 -I "$root/tools/pii-guard/pii_guard.py" --range "$range" || status=1
done
exit $status
