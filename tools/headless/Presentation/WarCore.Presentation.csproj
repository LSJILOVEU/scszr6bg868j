<Project Sdk="Microsoft.NET.Sdk">
  <!-- Mirrors Assets/WarCore/Presentation (only its engine-free sources are needed by the tests). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>WarCore.Presentation</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)../../../Assets/WarCore/Presentation/**/*.cs" />
    <ProjectReference Include="../Control/WarCore.Control.csproj" />
    <ProjectReference Include="../Sim/WarCore.Sim.csproj" />
    <ProjectReference Include="../Combat/WarCore.Combat.csproj" />
    <ProjectReference Include="../Content/WarCore.Content.csproj" />
    <ProjectReference Include="../Interim/WarCore.Interim.csproj" />
    <ProjectReference Include="../Battle/WarCore.Battle.csproj" />
  </ItemGroup>
</Project>
